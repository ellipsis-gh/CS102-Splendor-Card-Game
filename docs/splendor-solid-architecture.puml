@startuml
title Splendor Card Game - Current src/ Architecture (Simplified)

skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho
skinparam packageTitleAlignment center
skinparam ArrowThickness 3
skinparam ClassBorderThickness 2
skinparam PackageBorderThickness 2
skinparam NoteBorderThickness 2
left to right direction

package "src/interfaces" as InterfacesPkg {
  interface ICard
  interface IDeck
  interface INoble
  interface IBoard
  interface IPlayer
  interface IBank
}

package "src/model" as ModelPkg {
  enum Token
  enum Difficulty
  class Card
  class Deck
  class Noble
  class Board
  class Player
  class Bank
}

package "src/config" as ConfigPkg {
  class GameConfig
}

package "src/game" as DataPkg {
  class CardLoader
}

package "src/logic" as LogicPkg {
  class Game
  class BotMain
  class EasyAI
  class MediumAI
  class HardAI
  class InsaneAI
  class SplendorAI
  class AIHelpers
}

package "src/engine" as EnginePkg {
  class GameSetup
  class GameEngine
}

package "src/io" as IOPkg {
  interface InputHandler
  class ConsoleInputHandler
  class NetworkInputHandler
}

package "src/ui" as UIPkg {
  interface GameRenderer
  class ConsoleGameRenderer
  class NetworkGameRenderer
}

package "src/network" as NetworkPkg {
  class ServerMain
  class GameServer
  class ClientMain
  class ClientHandler
  class NetworkFormatter
}

package "src/util" as UtilPkg {
  class AnsiSupport
  class SplashScreen
  class GameApp
}

package "src/util/ui" as UtilUIPkg {
  class ConsoleUI
  class ConsoleRenderer
  class ConsoleViews
  class ConsoleFormat
  class HelperFunctions
}

class Main

' Layout guides to reduce crossing and keep responsibilities in columns.
ConfigPkg -[hidden]-> DataPkg
DataPkg -[hidden]-> EnginePkg
EnginePkg -[hidden]-> LogicPkg
LogicPkg -[hidden]-> ModelPkg
ModelPkg -[hidden]-> InterfacesPkg

Main -[hidden]down-> NetworkPkg
NetworkPkg -[hidden]down-> UtilPkg
EnginePkg -[hidden]down-> IOPkg
IOPkg -[hidden]-> UIPkg
UIPkg -[hidden]down-> UtilUIPkg

' Interface-based design
ModelPkg -[#E67E22,thickness=4,dashed]-> InterfacesPkg : implements interfaces
InputHandler <|-[#2980B9,thickness=3].. ConsoleInputHandler
InputHandler <|-[#2980B9,thickness=3].. NetworkInputHandler
GameRenderer <|-[#27AE60,thickness=3].. ConsoleGameRenderer
GameRenderer <|-[#27AE60,thickness=3].. NetworkGameRenderer

' Main local flow
Main -[#34495E,thickness=4,dashed]-> SplashScreen
Main -[#34495E,thickness=4,dashed]-> ConsoleUI
Main -[#34495E,thickness=4,dashed]-> GameSetup
Main -[#34495E,thickness=4,dashed]-> ConsoleInputHandler
Main -[#34495E,thickness=4,dashed]-> ConsoleGameRenderer
Main -[#34495E,thickness=4,dashed]-> GameEngine

' Setup and orchestration
GameSetup -[#2C3E50,thickness=4,dashed]-> GameConfig
GameSetup -[#2C3E50,thickness=4,dashed]-> CardLoader
GameSetup -[#2C3E50,thickness=4,dashed]-> ModelPkg
GameSetup -[#2C3E50,thickness=4,dashed]-> Game

GameEngine -[#8E44AD,thickness=4,dashed]-> Game
GameEngine -[#8E44AD,thickness=4,dashed]-> InputHandler
GameEngine -[#8E44AD,thickness=4,dashed]-> GameRenderer
GameEngine -[#8E44AD,thickness=4,dashed]-> BotMain

' Logic and AI
BotMain -[#9B59B6,thickness=3,dashed]-> EasyAI
BotMain -[#9B59B6,thickness=3,dashed]-> MediumAI
BotMain -[#9B59B6,thickness=3,dashed]-> HardAI
BotMain -[#9B59B6,thickness=3,dashed]-> InsaneAI
BotMain -[#9B59B6,thickness=3,dashed]-> AIHelpers
BotMain -[#9B59B6,thickness=3,dashed]-> Difficulty
SplendorAI -[#9B59B6,thickness=3,dashed]-> BotMain
Game -[#7F8C8D,thickness=3,dashed]-> ModelPkg

' UI / rendering reuse
ConsoleUI -[#27AE60,thickness=3,dashed]-> ConsoleRenderer
ConsoleUI -[#27AE60,thickness=3,dashed]-> AnsiSupport
ConsoleGameRenderer -[#27AE60,thickness=3,dashed]-> ConsoleRenderer
ConsoleGameRenderer -[#27AE60,thickness=3,dashed]-> AnsiSupport
NetworkGameRenderer -[#27AE60,thickness=3,dashed]-> NetworkFormatter
NetworkGameRenderer -[#27AE60,thickness=3,dashed]-> ClientHandler
NetworkFormatter -[#27AE60,thickness=3,dashed]-> ConsoleUI
NetworkFormatter -[#27AE60,thickness=3,dashed]-> Game

' Network flow
ServerMain -[#C0392B,thickness=4,dashed]-> SplashScreen
ServerMain -[#C0392B,thickness=4,dashed]-> GameServer
GameServer -[#C0392B,thickness=4,dashed]-> ClientHandler
GameServer -[#C0392B,thickness=4,dashed]-> GameSetup
GameServer -[#C0392B,thickness=4,dashed]-> GameEngine
GameServer -[#C0392B,thickness=4,dashed]-> NetworkInputHandler
GameServer -[#C0392B,thickness=4,dashed]-> NetworkGameRenderer
ClientMain -[#C0392B,thickness=4,dashed]-> SplashScreen
ClientMain -[#C0392B,thickness=4,dashed]-> NetworkFormatter
ClientMain -[#27AE60,thickness=3,dashed]-> AnsiSupport

