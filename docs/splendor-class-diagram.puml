@startuml
title Splendor Card Game - Current src/ Class Diagram (Simplified)

skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho
skinparam packageTitleAlignment center
skinparam ArrowThickness 5
skinparam ClassBorderThickness 4
skinparam PackageBorderThickness 4
skinparam nodesep 130
skinparam ranksep 150
left to right direction

package "src/interfaces" as InterfacesPkg {
  interface ICard
  interface IDeck
  interface INoble
  interface IBoard
  interface IPlayer
  interface IBank
}

package "src/model" as ModelPkg {
  enum Token
  enum Difficulty

  class Card
  class Deck
  class Noble
  class Board
  class Player
  class Bank
}

package "src/config" as ConfigPkg {
  class GameConfig
}

package "src/game" as DataPkg {
  class CardLoader
}

package "src/logic" as LogicPkg {
  class Game
  class BotMain
  class EasyAI
  class MediumAI
  class HardAI
  class InsaneAI
  class SplendorAI
  class AIHelpers
}

package "src/engine" as EnginePkg {
  class GameSetup
  class GameEngine
}

package "src/io" as IOPkg {
  interface InputHandler
  class ConsoleInputHandler
  class NetworkInputHandler
}

package "src/ui" as UIPkg {
  interface GameRenderer
  class ConsoleGameRenderer
  class NetworkGameRenderer
}

package "src/network" as NetworkPkg {
  class ServerMain
  class GameServer
  class ClientMain
  class ClientHandler
  class NetworkFormatter
}

package "src/util" as UtilPkg {
  class AnsiSupport
  class SplashScreen
  class GameApp
}

package "src/util/ui" as UtilUIPkg {
  class ConsoleUI
  class ConsoleRenderer
  class ConsoleViews
  class ConsoleFormat
  class HelperFunctions
}

class Main

' Layout guides to reduce crossing and keep related packages together.
ConfigPkg -[hidden]-> DataPkg
DataPkg -[hidden]-> EnginePkg
EnginePkg -[hidden]-> LogicPkg
LogicPkg -[hidden]-> ModelPkg
ModelPkg -[hidden]-> InterfacesPkg

Main -[hidden]down-> NetworkPkg
NetworkPkg -[hidden]down-> UtilPkg
EnginePkg -[hidden]down-> IOPkg
IOPkg -[hidden]-> UIPkg
UIPkg -[hidden]down-> UtilUIPkg

' Core ownership relationships
Board *-[#7F8C8D]- "3" Deck
Board *-[#7F8C8D]- "0..*" Noble
Board *-[#7F8C8D]- "12" Card
Player *-[#7F8C8D]- "0..*" Card : reserved + purchased
Player *-[#7F8C8D]- "0..*" Noble
Game *-[#7F8C8D]- Board
Game *-[#7F8C8D]- "2..4" Player

' Interfaces and abstractions
ModelPkg -[#E67E22,thickness=3,dashed]-> InterfacesPkg : implements interfaces
InputHandler <|-[#2980B9].. ConsoleInputHandler
InputHandler <|-[#2980B9].. NetworkInputHandler
GameRenderer <|-[#27AE60].. ConsoleGameRenderer
GameRenderer <|-[#27AE60].. NetworkGameRenderer

' Local and network orchestration
Main -[#34495E,dashed]-> GameSetup
Main -[#34495E,dashed]-> GameEngine
Main -[#34495E,dashed]-> ConsoleUI

ServerMain -[#C0392B,dashed]-> GameServer
GameServer -[#C0392B,dashed]-> GameSetup
GameServer -[#C0392B,dashed]-> GameEngine
GameServer -[#C0392B,dashed]-> NetworkInputHandler
GameServer -[#C0392B,dashed]-> NetworkGameRenderer

' Setup and engine
GameSetup -[#2C3E50,dashed]-> GameConfig
GameSetup -[#2C3E50,dashed]-> CardLoader
GameSetup -[#2C3E50,dashed]-> Game
GameSetup -[#2C3E50,dashed]-> ModelPkg

GameEngine -[#8E44AD,dashed]-> Game
GameEngine -[#8E44AD,dashed]-> InputHandler
GameEngine -[#8E44AD,dashed]-> GameRenderer
GameEngine -[#8E44AD,dashed]-> BotMain

' AI structure
BotMain -[#9B59B6,dashed]-> EasyAI
BotMain -[#9B59B6,dashed]-> MediumAI
BotMain -[#9B59B6,dashed]-> HardAI
BotMain -[#9B59B6,dashed]-> InsaneAI
BotMain -[#9B59B6,dashed]-> AIHelpers
SplendorAI -[#9B59B6,dashed]-> BotMain

' Rendering reuse
ConsoleUI -[#27AE60,dashed]-> ConsoleRenderer
ConsoleGameRenderer -[#27AE60,dashed]-> ConsoleRenderer
NetworkGameRenderer -[#27AE60,dashed]-> NetworkFormatter
NetworkFormatter -[#27AE60,dashed]-> ConsoleUI

@enduml
