@startuml
title Splendor Card Game - SOLID-Oriented Class Diagram

skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam shadowing false
left to right direction

package "Domain Abstractions" {
  interface ICard
  interface IDeck
  interface INoble
  interface IBoard
  interface IPlayer
}

package "Domain Model" {
  enum Token

  class Card {
    - level : int
    - prestigePoints : int
    - bonus : Token
    - cost : Map<Token, Integer>
  }

  class Noble {
    - prestigePoints : int
    - cost : Map<Token, Integer>
  }

  class Deck {
    - level : int
    - cards : List<Card>
    + shuffle()
    + draw() : Card
  }

  class Board {
    - availableTokens : Map<Token, Integer>
    - nobles : List<Noble>
    - level1Visible : Card[]
    - level2Visible : Card[]
    - level3Visible : Card[]
    + refillMarket()
    + getVisibleCards(level : int) : Card[]
    + drawFromDeck(level : int) : Card
  }

  class Player {
    - name : String
    - isHuman : boolean
    - tokens : Map<Token, Integer>
    - hand : List<Card>
    - purchasedCards : List<Card>
    - nobles : List<Noble>
    + canAffordCard(card : Card) : boolean
    + payForCard(card : Card, board : Board)
    + buyCard(card : Card)
    + reserveCard(card : Card)
    + getScore() : int
  }
}

package "Game Logic" {
  class Game {
    - board : Board
    - players : List<Player>
    - currentPlayerIndex : int
    - gameOver : boolean
    + getCurrentPlayer() : Player
    + nextTurn()
    + takeThreeDifferentGems(player : Player, t1 : Token, t2 : Token, t3 : Token)
    + takeTwoSameGems(player : Player, token : Token)
    + buyVisibleCard(player : Player, level : int, slot : int)
    + buyReservedCard(player : Player, reservedIndex : int)
    + reserveVisibleCard(player : Player, level : int, slot : int)
    + reserveDeckCard(player : Player, level : int)
    + checkAndAwardNoble(player : Player) : Noble
  }

  class SplendorAI {
    + chooseAction(player : Player, board : Board) : String
    + chooseTokensToReturn(player : Player, board : Board, toReturn : int) : List<Token>
  }
}

package "Application / Setup" {
  class CardLoader {
    + loadCards(path : String) : List<Card>
    + loadNobles(path : String) : List<Noble>
  }

  class GameConfig {
    + getWinningPoints() : int
    + getCardFilePath() : String
    + getNobleFilePath() : String
    + getInitialNobles(playerCount : int) : int
  }

  class GameApp {
    + setupGame(numPlayers : int, isAI : boolean[]) : Game
    + setupGame(numPlayers : int, isAI : boolean[], playerNames : String[]) : Game
    + runGameLoop(game : Game, sc : Scanner, ui : ConsoleUI)
  }
}

package "Presentation" {
  class ConsoleUI {
    + getNumberOfPlayers() : int
    + getPlayerTypes(numberOfPlayers : int) : boolean[]
    + renderGameStateString(game : Game, ansi : boolean) : String
    + displayGameState(game : Game)
    + displayReservedCards(player : Player)
  }

  class NetworkFormatter {
    + formatGameState(game : Game) : String
  }

  class AnsiSupport {
    + isSupported() : boolean
  }
}

package "Transport / Entry Points" {
  class Main {
    + main(args : String[])
  }

  class ServerMain {
    + main(args : String[])
  }

  class GameServer {
    - port : int
    + start()
  }

  class ClientMain {
    + main(args : String[])
  }

  class ClientHandler {
    - socket : Socket
    - playerName : String
    + readLine() : String
    + send(message : String)
    + close()
  }
}

ICard <|-[#E67E22].. Card
IDeck <|-[#E67E22].. Deck
INoble <|-[#E67E22].. Noble
IBoard <|-[#E67E22].. Board
IPlayer <|-[#E67E22].. Player

Board *-[#7F8C8D]- "3" Deck
Board *-[#7F8C8D]- "0..*" Noble
Board *-[#7F8C8D]- "12" Card : visible market
Deck *-[#7F8C8D]- "0..*" Card
Player *-[#7F8C8D]- "0..*" Card : reserved
Player *-[#7F8C8D]- "0..*" Card : purchased
Player *-[#7F8C8D]- "0..*" Noble
Game *-[#7F8C8D]- Board
Game *-[#7F8C8D]- "2..*" Player

Card -[#7F8C8D,dashed]-> Token
Noble -[#7F8C8D,dashed]-> Token
Board -[#7F8C8D,dashed]-> Token
Player -[#7F8C8D,dashed]-> Token

SplendorAI -[#8E44AD,dashed]-> Board
SplendorAI -[#8E44AD,dashed]-> Player
SplendorAI -[#8E44AD,dashed]-> Card

CardLoader -[#2C3E50,dashed]-> Card
CardLoader -[#2C3E50,dashed]-> Noble
GameApp -[#2980B9,dashed]-> Game
GameApp -[#2980B9,dashed]-> CardLoader
GameApp -[#2980B9,dashed]-> GameConfig
GameApp -[#2980B9,dashed]-> ConsoleUI
GameApp -[#2980B9,dashed]-> SplendorAI

ConsoleUI -[#27AE60,dashed]-> Game
ConsoleUI -[#27AE60,dashed]-> Player
ConsoleUI -[#27AE60,dashed]-> AnsiSupport
NetworkFormatter -[#27AE60,dashed]-> Game
NetworkFormatter -[#27AE60,dashed]-> ConsoleUI

Main -[#2980B9,dashed]-> GameApp
Main -[#2980B9,dashed]-> ConsoleUI
ServerMain -[#C0392B,dashed]-> GameServer
GameServer -[#C0392B,dashed]-> Game
GameServer -[#C0392B,dashed]-> GameApp
GameServer -[#C0392B,dashed]-> NetworkFormatter
GameServer -[#C0392B,dashed]-> ClientHandler
ClientMain -[#C0392B,dashed]-> NetworkFormatter
ClientMain -[#27AE60,dashed]-> AnsiSupport

note right of "Domain Abstractions"
  Interface Segregation:
  small focused interfaces
  for core game entities.
end note

note right of "Game Logic"
  Single Responsibility:
  game rules and AI decisions
  are separated from UI/networking.
end note

note right of "Presentation"
  Presentation classes only render
  and collect/display information.
end note

note right of "Transport / Entry Points"
  Entry-point and transport classes
  coordinate flow without owning
  domain rules.
end note

@enduml
